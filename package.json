{
  "name": "luogu-notebook",
  "version": "1.2.0",
  "description": "洛谷刷题本 —— 本地运行的刷题记录工具：文件夹树索引（可切换按算法/按比赛分类）、洛谷进度同步、题单导入、C++ 本地评测、代码版本历史、一键导出 PDF（带目录与书签）/ Markdown / PNG 分享卡片",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --open",
    "test": "node tools/test-roundtrip.mjs && node tools/test-print-css.mjs && node tools/test-safety.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "test:pdf": "node tools/test-pdf.mjs",
    "package": "node tools/package.mjs",
    "test:export": "node tools/test-exports.mjs",
    "test:history": "node tools/test-history.mjs",
    "test:toc": "node tools/test-toc.mjs"
  },
  "keywords": [
    "luogu",
    "oi",
    "competitive-programming",
    "notebook",
    "markdown"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "private": false
}
